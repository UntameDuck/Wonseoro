# 인증 시험용 대학 API — oidc 모드 (docs/12-authentication-plan.md). CI 재현 DB(:5499) 와 로컬 발급자(:18080) 가 있어야 한다
PORT=3111
UNIVERSITY_ID=UNIV-A
DATABASE_URL=postgresql://kadmission_app:kadmission_app_dev@localhost:5499/univ_a
AUTH_MODE=oidc
OIDC_APPLICANT_ISSUER=http://localhost:18080/realms/wonseoro-applicant
OIDC_STAFF_ISSUER=http://localhost:18080/realms/wonseoro-staff
OTEL_METRICS_PORT=9482
CLOCK_AUTOSTART=false
PAYMENT_RECHECK_AUTOSTART=false
RECON_SCHEDULE_AUTOSTART=false
CENTRAL_GATE_AUTOSTART=false
S3_AUTO_CREATE_BUCKET=false
