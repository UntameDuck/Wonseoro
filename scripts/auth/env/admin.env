# 인증 시험용 운영 콘솔 — 관리자 로그인(oidc). 값은 로컬 전용 시험값이다(렐름 파일 infra/auth/wonseoro-staff.realm.json 과 같다)
ADMIN_AUTH_MODE=oidc
ADMIN_OIDC_ISSUER=http://localhost:18080/realms/wonseoro-staff
ADMIN_OIDC_CLIENT_ID=admin-web
ADMIN_OIDC_CLIENT_SECRET=admin-web-dev-secret
ADMIN_PUBLIC_URL=http://localhost:4100
ADMIN_SESSION_SECRET=dev-only-admin-session-secret-0123456789abcdef
ADMISSION_API_URL=http://localhost:3111
