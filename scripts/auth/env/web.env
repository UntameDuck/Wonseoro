# 인증 시험용 지원자 화면 — 본인확인(OIDC) 모드. 렐름의 applicant-web 클라이언트가 :3001 로 돌아오기를 허용한다
NEXT_PUBLIC_AUTH_MODE=oidc
NEXT_PUBLIC_OIDC_ISSUER=http://localhost:18080/realms/wonseoro-applicant
NEXT_PUBLIC_OIDC_CLIENT_ID=applicant-web
NEXT_PUBLIC_ADMISSION_API=http://localhost:3111
NEXT_PUBLIC_CENTRAL_API=http://localhost:3112
NEXT_PUBLIC_DEV_IDENTITY=0
