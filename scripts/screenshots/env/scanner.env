# 화면 캡처 전용 (scripts/screenshots) — 전용 DB ui-shots-pg :5497 · 전용 포트. 개발용 값만 있다
# document-service — 서류 검사 워커

PORT=3102
NODE_ENV=development
# 앱 역할(kadmission_app) — 감사 기록을 고치거나 지울 권한이 없다 (D-41). npm run db:migrate 가 만든다
DATABASE_URL=postgresql://kadmission_app:kadmission_app_dev@localhost:5497/univ_a
ADMISSION_API_URL=http://localhost:3101

# mock | clamav. mock 은 운영에서 선택될 수 없다 — 검사했다는 기록만 남고 실제로는
# 아무것도 검사하지 않은 상태가 가장 위험하다. 실 엔진은 clamav (D-58)
SCANNER_ENGINE=mock
# clamav 엔진일 때 — clamd 주소(필수)·포트·시간 제한. 워커는 접수 API 가 준 서명 URL 로 파일을 읽는다
# CLAMD_HOST=127.0.0.1
# CLAMD_PORT=3310
# CLAMD_TIMEOUT_MS=30000

SCANNER_AUTOSTART=true
SCANNER_INTERVAL_MS=3000
# mock 엔진 — 검사 시간을 흉내 낸다. 화면의 "검사 중" 을 실제로 보이게 하려는 목적.
SCANNER_DELAY_MS=1500
SCANNER_TIMEOUT_MS=5000
# mock 엔진의 버전 표기. clamav 는 clamd 에 직접 묻는다
SCANNER_VERSION=mock-dev
# Circuit Breaker. 열려 있는 동안은 대상을 집지 않는다
BREAKER_FAILURE_THRESHOLD=5
BREAKER_OPEN_MS=30000
OTEL_METRICS_PORT=9477
