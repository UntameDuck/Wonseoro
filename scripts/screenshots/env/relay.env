# 화면 캡처 전용 (scripts/screenshots) — 전용 DB ui-shots-pg :5497 · 전용 포트. 개발용 값만 있다
# event-relay — 대학 → 중앙 이벤트 중계
#
# UNIVERSITY_ID 는 CloudEvents 의 source 가 된다. 중앙은 source + id 로 중복을
# 판정하므로, 이 값이 틀리면 중복 제거와 순서 보장이 함께 깨진다. 기본값을 두지 않는다.

PORT=3103
NODE_ENV=development
UNIVERSITY_ID=UNIV-A
# 앱 역할(kadmission_app) — 감사 기록을 고치거나 지울 권한이 없다 (D-41). npm run db:migrate 가 만든다
DATABASE_URL=postgresql://kadmission_app:kadmission_app_dev@localhost:5497/univ_a

# 닿지 않아도 접수는 계속된다. 통합 조회만 늦어진다.
CENTRAL_SYNC_URL=http://localhost:3100

RELAY_AUTOSTART=true
RELAY_INTERVAL_MS=2000
RELAY_BATCH_SIZE=100
RELAY_TIMEOUT_MS=5000
# §04 sync.heartbeat 주기 — 적체·설정 버전·시계 offset. Outbox 를 거치지 않고, 중앙이 끊기면 건너뛴다 (D-60)
RELAY_HEARTBEAT_INTERVAL_MS=60000
# 심장박동에 실리는 플랫폼 버전(배포가 이미지 태그를 넣는다). 없으면 unknown
PLATFORM_VERSION=dev
# Circuit Breaker. 열려 있는 동안은 대상을 집지 않는다
BREAKER_FAILURE_THRESHOLD=5
BREAKER_OPEN_MS=30000
OTEL_METRICS_PORT=9476
