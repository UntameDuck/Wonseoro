# document-service — 서류 검사 워커

PORT=3002
NODE_ENV=development
DATABASE_URL=postgresql://wonseoro:wonseoro@localhost:5432/univ_a
ADMISSION_API_URL=http://localhost:3001

# mock 은 운영에서 선택될 수 없다. 검사했다는 기록만 남고 실제로는
# 아무것도 검사하지 않은 상태가 가장 위험하다. (실 엔진 연동 T-M5-08)
SCANNER_ENGINE=mock

SCANNER_AUTOSTART=true
SCANNER_INTERVAL_MS=3000
# 검사 시간을 흉내 낸다. 화면의 "검사 중" 을 실제로 보이게 하려는 목적.
SCANNER_DELAY_MS=1500
SCANNER_TIMEOUT_MS=5000
SCANNER_VERSION=dev-0
# Circuit Breaker. 열려 있는 동안은 대상을 집지 않는다
BREAKER_FAILURE_THRESHOLD=5
BREAKER_OPEN_MS=30000
