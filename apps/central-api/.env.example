# central-api — 중앙 Convenience/Control Plane
#
# 중앙은 지원자의 Critical Path 가 아니다. 여기가 꺼져도 대학 접수는 계속된다.

PORT=3000
NODE_ENV=development
DATABASE_URL=postgresql://wonseoro:wonseoro@localhost:5434/central
CORS_ORIGINS=http://localhost:4000

# "내 원서" 조회용 지원자 참조 키 목록 — 첫 번째가 현재 키. 대학의 CENTRAL_SUBJECT_KEY 와 같아야 한다.
# Vault 서비스에는 주지 않는다. 둘을 함께 가지면 지원자 참조가 다시 Vault 와 조인된다.
SUBJECT_REF_KEYS=k1=dev-dashboard-subject-key
