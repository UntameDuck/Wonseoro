# event-relay — 대학 → 중앙 이벤트 중계
#
# UNIVERSITY_ID 는 CloudEvents 의 source 가 된다. 중앙은 source + id 로 중복을
# 판정하므로, 이 값이 틀리면 중복 제거와 순서 보장이 함께 깨진다. 기본값을 두지 않는다.

PORT=3003
NODE_ENV=development
UNIVERSITY_ID=UNIV-A
DATABASE_URL=postgresql://wonseoro:wonseoro@localhost:5432/univ_a

# 닿지 않아도 접수는 계속된다. 통합 조회만 늦어진다.
CENTRAL_SYNC_URL=http://localhost:3000

RELAY_AUTOSTART=true
RELAY_INTERVAL_MS=2000
RELAY_BATCH_SIZE=100
RELAY_TIMEOUT_MS=5000
