{
  "name": "@wonseoro/event-relay",
  "version": "0.0.1",
  "private": true,
  "description": "Outbox Relay — 대학 Outbox를 중앙 Sync Gateway로 at-least-once 전송",
  "scripts": {
    "dev": "nest start --watch",
    "build": "nest build",
    "start": "node dist/main.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node --test --test-concurrency=1 \"dist/**/*.test.js\"",
    "pretest": "npm run build"
  },
  "dependencies": {
    "@nestjs/common": "^11.2.7",
    "@nestjs/config": "^4.0.4",
    "@nestjs/core": "^11.2.7",
    "@nestjs/platform-fastify": "^11.2.7",
    "@opentelemetry/api": "^1.9.1",
    "@wonseoro/contracts": "*",
    "@wonseoro/server-kit": "*",
    "pg": "^8.13.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2"
  },
  "devDependencies": {
    "@nestjs/cli": "^11.0.24",
    "@nestjs/schematics": "^11.1.0",
    "@opentelemetry/context-async-hooks": "^2.11.0",
    "@opentelemetry/core": "^2.11.0",
    "@opentelemetry/sdk-trace-base": "^2.11.0",
    "@types/pg": "^8.11.0"
  }
}
