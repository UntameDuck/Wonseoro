PORT=3001
NODE_ENV=development
UNIVERSITY_ID=UNIV-A
DATABASE_URL=postgresql://wonseoro:wonseoro@localhost:5432/univ_a
REDIS_URL=redis://localhost:6379
# 중앙은 Critical Path가 아니다. 아래가 끊겨도 접수는 계속되어야 한다.
CENTRAL_SYNC_URL=http://localhost:3000
S3_ENDPOINT=http://localhost:9000
S3_BUCKET=univ-a-documents
S3_ACCESS_KEY=wonseoro
S3_SECRET_KEY=wonseoro123
# 개발 전용. 운영 버킷은 IaC 로 만든다.
S3_AUTO_CREATE_BUCKET=true

# 마감 판정은 DB 의 승인·활성화된 정책만 근거로 한다. (T-M3-01)
# 개발 중 정책을 만들기 전까지만 true 로 둔다. 운영에서는 절대 true 로 두지 않는다.
ALLOW_ENV_DEADLINE_POLICY=true
