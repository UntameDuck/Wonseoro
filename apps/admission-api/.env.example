# admission-api — 대학 Data Plane
#
# 운영에서는 아래 값이 빠지면 **기동하지 않는다.** (src/config.ts)
# 잘못된 설정으로 떠서 첫 지원자에게 500 을 주는 것보다 안 뜨는 편이 낫다.

PORT=3001
NODE_ENV=development

# 이 프로세스가 어느 대학의 접수를 처리하는가. 공통원서 조회와 접수번호에 쓰인다.
UNIVERSITY_ID=UNIV-A

# 앱 역할(kadmission_app) — 감사 기록을 고치거나 지울 권한이 없다 (D-41). npm run db:migrate 가 만든다
DATABASE_URL=postgresql://kadmission_app:kadmission_app_dev@localhost:5432/univ_a

# 지원자 웹 오리진. 운영에서 기본값을 쓰면 개발 도메인이 열린다.
CORS_ORIGINS=http://localhost:4000

# 중앙은 Critical Path 가 아니다. 아래가 끊겨도 접수는 계속되어야 한다.
CENTRAL_SYNC_URL=http://localhost:3000
VAULT_TIMEOUT_MS=2000
# 외부 의존성 Circuit Breaker (중앙 Vault·PG). 연속 N회 실패로 열고 OPEN_MS 뒤 탐침 1건
BREAKER_FAILURE_THRESHOLD=5
BREAKER_OPEN_MS=30000
# 중앙 생존 확인 간격과 반영 지연 경보 기준 (Autonomous Mode 배너의 근거)
CENTRAL_GATE_AUTOSTART=true
CENTRAL_GATE_INTERVAL_MS=10000
SYNC_LAG_WARN_SECONDS=300

# ── 서버 시각 (§A9, D-61) ─────────────────────────────────────────────
# 이 노드 시계와 DB 시계의 차이를 INTERVAL 마다 PROBES 번 잰다(왕복이 가장 짧은 표본).
# 불확실성을 빼고도 1초를 넘으면 이 노드는 Finalize 만 503 으로 거절한다.
CLOCK_AUTOSTART=true
CLOCK_SAMPLE_INTERVAL_MS=10000
CLOCK_PROBES_PER_SAMPLE=3

# 만료(24시간)된 멱등 기록 정리 주기. Peak Mode 억제 구간에는 쉰다
IDEMPOTENCY_PURGE_AUTOSTART=true
IDEMPOTENCY_PURGE_INTERVAL_MS=900000

# ── 신원 ──────────────────────────────────────────────────────────────
# dev-headers: x-applicant-id / x-admin-id 헤더를 그대로 믿는다. **개발 전용**
# gateway:     앞단 인증 게이트웨이가 검증해 넣어준 신원만 받는다
# oidc:        이 API 가 Bearer 액세스 토큰을 직접 검증한다 (T-M5-02·10, docs/12-authentication-plan.md)
AUTH_MODE=dev-headers

# ── oidc 모드 ── 로컬 발급자: docker compose -f infra/compose/docker-compose.dev.yml --profile auth up -d keycloak
# 운영에서는 https·로컬 아닌 주소여야 기동한다.
# OIDC_APPLICANT_ISSUER=http://localhost:18080/realms/wonseoro-applicant
# OIDC_STAFF_ISSUER=http://localhost:18080/realms/wonseoro-staff
# OIDC_AUDIENCE=wonseoro-admission-api
# 담당자 토큰에 요구하는 인증 수준(비밀번호+OTP)과 민감 동작의 재인증 시간(초)
# OIDC_STAFF_ACR=mfa
# OIDC_STEP_UP_MAX_AGE_SEC=300
# 발급자 공개키 스냅숏 폴더 — 발급자 장애 중 재기동해도 검증이 이어진다. 키를 못 받은 채 이 시간이 지나면 검증을 멈춘다
# OIDC_JWKS_SNAPSHOT_DIR=
# OIDC_JWKS_MAX_STALE_MS=86400000

# /admin/v1 공유 비밀(dev-headers·gateway 모드). 비우면 운영 API 가 열린 채로 뜬다 — 개발에서만 허용된다.
# 운영에서는 필수다. 인증이 아니라 최소한의 문이다. oidc 모드에서는 쓰지 않는다.
ADMIN_API_TOKEN=

# ── 결제 ──────────────────────────────────────────────────────────────
# mock 은 운영에서 선택될 수 없다. 돈을 받지 않고 받았다고 기록하기 때문이다.
PAYMENT_PROVIDER=mock
# 흉내 PG 의 강제 결과. OK | SLOW | FAIL | UNKNOWN | DOWN.
# 비우면 거래번호의 표식(SLOW·FAIL·UNKNOWN)을 따르고, 표식이 없으면 성공한다.
MOCK_PG_BEHAVIOUR=
# PG 콜백 서명 비밀 (POST /api/v1/payments/callbacks/:provider). 운영에서는 필수다.
# 서명이 맞아도 콜백의 상태 값은 쓰지 않는다 — PG 에 다시 묻는다. (D-40)
PG_CALLBACK_SECRET=
# 결제 재확인 워커 — PENDING·UNKNOWN 을 결제별 Backoff(30초→30분)로 PG 에 다시 묻는다
PAYMENT_RECHECK_AUTOSTART=true
PAYMENT_RECHECK_INTERVAL_MS=30000
PAYMENT_RECHECK_BATCH=50
PAYMENT_RECHECK_MAX_AGE_HOURS=48
# 대조 자동 실행 — 1시간마다 최근 48시간 (§B18 D+1 을 매시간 덮는다)
RECON_SCHEDULE_AUTOSTART=true
RECON_SCHEDULE_INTERVAL_MS=3600000
RECON_SCHEDULE_SINCE_HOURS=48
PEAK_MODE_ENABLED=false
PEAK_MODE_ACTIVATES_AT=
PEAK_MODE_SUSPEND_NON_CRITICAL_JOBS=true

# ── 관측성 ────────────────────────────────────────────────────────────
# Prometheus는 별도 포트의 /metrics만 수집한다. 라벨에 본문·헤더·사용자 식별자는 넣지 않는다.
OTEL_ENABLED=true
OTEL_METRICS_PORT=9464
# 비우면 trace exporter를 끈다. 운영은 OTLP/gRPC Collector 주소를 넣는다 (예: http://otel:4317).
OTEL_EXPORTER_OTLP_ENDPOINT=

# ── Object Storage ────────────────────────────────────────────────────
S3_ENDPOINT=http://localhost:9000
S3_BUCKET=univ-a-documents
S3_REGION=us-east-1
S3_ACCESS_KEY=wonseoro
S3_SECRET_KEY=wonseoro123
# 로컬 S3 호환 저장소는 path-style. 운영 CSP 는 대개 virtual-host 라 false 로 둔다.
S3_FORCE_PATH_STYLE=true
# 개발 전용. 운영 버킷은 IaC 로 만든다.
S3_AUTO_CREATE_BUCKET=true

# ── 가명처리 소금 ─────────────────────────────────────────────────────
# 고정값이면 가명처리가 아니다. IPv4 전체를 해시해 대조하면 몇 초면 원본이 나온다.
# 운영에서는 둘 다 필수이고, 배포마다 다른 값이어야 한다.
AUDIT_IP_SALT=dev-salt
CENTRAL_ID_SALT=dev-salt
# "내 원서" 조회용 지원자 참조 키. 모든 대학·중앙 대시보드가 같은 키를 쓴다. Vault 에는 주지 않는다.
CENTRAL_SUBJECT_KEY=dev-dashboard-subject-key
CENTRAL_SUBJECT_KEY_ID=k1

# ── 설정 거버넌스 ─────────────────────────────────────────────────────
# 마감 몇 시간 전부터 설정 변경을 잠글 것인가. (§A14 Freeze)
# 되돌리기에는 걸리지 않는다 — 잠금은 새 변경을 멈추는 장치다.
# 마감 연장은 마감 정책의 일이라 이 잠금과 무관하다.
CONFIG_FREEZE_HOURS=24

# 마감·설정 적용 기록 서명 키 (Ed25519 PKCS#8 PEM). 비우면 개발용 고정 키 — 운영에서는 필수다.
# 개발 키로 서명한 기록은 누구나 같은 서명을 만들 수 있으므로 아무것도 증명하지 못한다.
POLICY_SIGNING_KEY=
POLICY_SIGNING_KEY_ID=dev-ed25519-1

# ── 마감 ──────────────────────────────────────────────────────────────
# 마감 판정은 DB 의 승인·활성화된 정책만 근거로 한다. (T-M3-01)
# 개발 중 정책을 만들기 전까지만 true. 운영에서 true 면 기동을 막는다.
ALLOW_ENV_DEADLINE_POLICY=true
DEADLINE_MODE=FINALIZED_COMMIT_BEFORE_DEADLINE
DEADLINE_AT=
